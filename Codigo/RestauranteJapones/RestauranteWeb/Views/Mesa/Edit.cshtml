@model RestauranteWeb.Models.MesaViewModel

@{
    ViewData["Title"] = "Editar Mesa";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h4 class="mb-0">Editar Mesa</h4>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label asp-for="Identificacao" class="form-label"></label>
                        <input asp-for="Identificacao" class="form-control" />
                        <span asp-validation-for="Identificacao" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="IdRestaurante" class="form-label">Restaurante</label>
                        <select asp-for="IdRestaurante" asp-items="ViewBag.IdRestaurante" class="form-select">
                            <option value="">-- Selecione um restaurante --</option>
                        </select>
                        <span asp-validation-for="IdRestaurante" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
                        <button type="submit" class="btn btn-success px-4">Guardar alterações</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}