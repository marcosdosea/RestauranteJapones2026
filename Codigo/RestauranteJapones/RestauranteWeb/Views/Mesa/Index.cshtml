@model IEnumerable<RestauranteWeb.Models.MesaViewModel>

@{
    ViewData["Title"] = "Mesas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0">Mesas</h2>
        <small class="text-muted">Gestão de mesas cadastradas</small>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        + Nova Mesa
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <div class="table-responsive">
            <table id="tabelaMesas" class="table table-striped table-hover align-middle w-100">
                <thead class="table-light">
                    <tr>
                        <th>Identificação</th>
                        <th>Restaurante</th>
                        <th class="text-end" style="width: 210px;">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.Identificacao</td>
                            <td>@item.IdRestaurante</td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Editar</a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Detalhes</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Excluir</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            if ($.fn.DataTable) {
                $('#tabelaMesas').DataTable({
                    language: {
                        url: '/lib/datatables.net/js/pt-BR.json'
                    },
                    order: [[0, 'asc']],
                    columnDefs: [
                        { orderable: false, targets: -1 }
                    ]
                });
            }
        });
    </script>
}