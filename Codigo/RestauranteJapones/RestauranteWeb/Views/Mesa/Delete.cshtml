@model RestauranteWeb.Models.MesaViewModel

@{
    ViewData["Title"] = "Excluir Mesa";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow-sm border-danger">
            <div class="card-header bg-danger text-white py-3">
                <h4 class="mb-0">Confirmar exclusão</h4>
            </div>
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <p class="mb-3">Tens a certeza de que pretendes excluir esta mesa?</p>

                <dl class="row mb-0 bg-light p-3 rounded">
                    <dt class="col-sm-4 text-muted">
                        @Html.DisplayNameFor(model => model.Identificacao)
                    </dt>
                    <dd class="col-sm-8 fw-semibold">
                        @Html.DisplayFor(model => model.Identificacao)
                    </dd>

                    <dt class="col-sm-4 text-muted">
                        @Html.DisplayNameFor(model => model.IdRestaurante)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.IdRestaurante)
                    </dd>
                </dl>
            </div>
            <div class="card-footer bg-white">
                <form asp-action="Delete" method="post" class="d-flex justify-content-between">
                    <input type="hidden" asp-for="Id" />
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-danger px-4">Excluir</button>
                </form>
            </div>
        </div>
    </div>
</div>