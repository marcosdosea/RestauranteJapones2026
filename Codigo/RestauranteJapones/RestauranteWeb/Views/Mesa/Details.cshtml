@model RestauranteWeb.Models.MesaViewModel

@{
    ViewData["Title"] = "Detalhes da Mesa";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h4 class="mb-0">Detalhes da Mesa</h4>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">
                        @Html.DisplayNameFor(model => model.Identificacao)
                    </dt>
                    <dd class="col-sm-8 fw-semibold">
                        @Html.DisplayFor(model => model.Identificacao)
                    </dd>

                    <dt class="col-sm-4 text-muted">
                        @Html.DisplayNameFor(model => model.IdRestaurante)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.IdRestaurante)
                    </dd>
                </dl>
            </div>
            <div class="card-footer bg-white d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
            </div>
        </div>
    </div>
</div>