@model IEnumerable<RestauranteWeb.Models.RestauranteViewModel>
@{
    ViewData["Title"] = "Restaurantes";
}

<h1>Restaurantes</h1>
@if (TempData["SuccessMessage"] is string successMessage)
{
    <p class="alert alert-success" role="status">@successMessage</p>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <p class="alert alert-danger" role="alert">@errorMessage</p>
}
<p><a asp-action="Create" class="btn btn-primary">Novo restaurante</a></p>
<table class="table">
    <caption class="visually-hidden">Restaurantes cadastrados</caption>
    <thead><tr><th scope="col">Nome</th><th scope="col">CNPJ</th><th scope="col">Tipo</th><th scope="col">Ações</th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Nome</td>
            <td>@item.Cnpj</td>
            <td>@item.NomeTipoRestaurante</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Detalhes</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Excluir</a>
            </td>
        </tr>
    }
    </tbody>
</table>
