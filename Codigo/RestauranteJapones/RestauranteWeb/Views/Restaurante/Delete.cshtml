@model RestauranteWeb.Models.RestauranteViewModel
@{
    ViewData["Title"] = "Delete";
}
<h1>Delete</h1>
<h3>Are you sure you want to delete this?</h3>
<hr />
<section aria-labelledby="resumo-restaurante">
    <h2 id="resumo-restaurante" class="visually-hidden">Resumo do restaurante</h2>
    <dl class="row"><dt class="col-sm-2">CNPJ</dt><dd class="col-sm-10">@Model.Cnpj</dd><dt class="col-sm-2">Tipo</dt><dd class="col-sm-10">@Model.NomeTipoRestaurante</dd></dl>
</section>
<form asp-action="Delete">
    <p asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></p>
    <input type="hidden" asp-for="Id" />
    <input type="submit" value="Delete" class="btn btn-danger" /> |
    <a asp-action="Index">Back to List</a>
</form>
