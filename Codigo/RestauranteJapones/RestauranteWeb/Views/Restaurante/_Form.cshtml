@model RestauranteWeb.Models.RestauranteViewModel
<fieldset class="row">
    <legend class="visually-hidden">Dados do restaurante</legend>
    <p class="col-md-6 form-group mb-3"><label asp-for="Nome" class="control-label"></label><input asp-for="Nome" class="form-control" /><span asp-validation-for="Nome" class="text-danger"></span></p>
    <p class="col-md-6 form-group mb-3"><label asp-for="Cnpj" class="control-label"></label><input asp-for="Cnpj" class="form-control" /><span asp-validation-for="Cnpj" class="text-danger"></span></p>
    <p class="col-md-6 form-group mb-3"><label asp-for="IdTipoRestaurante" class="control-label"></label><select asp-for="IdTipoRestaurante" asp-items="ViewBag.IdTipoRestaurante" class="form-select"><option value="">Selecione</option></select><span asp-validation-for="IdTipoRestaurante" class="text-danger"></span></p>
    <p class="col-md-6 form-group mb-3"><label asp-for="Cep" class="control-label"></label><input asp-for="Cep" class="form-control" /><span asp-validation-for="Cep" class="text-danger"></span></p>
    <p class="col-md-8 form-group mb-3"><label asp-for="Rua" class="control-label"></label><input asp-for="Rua" class="form-control" /><span asp-validation-for="Rua" class="text-danger"></span></p>
    <p class="col-md-4 form-group mb-3"><label asp-for="Bairro" class="control-label"></label><input asp-for="Bairro" class="form-control" /><span asp-validation-for="Bairro" class="text-danger"></span></p>
    <p class="col-md-6 form-group mb-3"><label asp-for="Cidade" class="control-label"></label><input asp-for="Cidade" class="form-control" /><span asp-validation-for="Cidade" class="text-danger"></span></p>
    <p class="col-md-2 form-group mb-3"><label asp-for="Estado" class="control-label"></label><input asp-for="Estado" class="form-control" maxlength="2" /><span asp-validation-for="Estado" class="text-danger"></span></p>
    <p class="col-md-5 form-group mb-3"><label asp-for="Telefone1" class="control-label"></label><input asp-for="Telefone1" class="form-control" /><span asp-validation-for="Telefone1" class="text-danger"></span></p>
    <p class="col-md-5 form-group mb-3"><label asp-for="Telefone2" class="control-label"></label><input asp-for="Telefone2" class="form-control" /><span asp-validation-for="Telefone2" class="text-danger"></span></p>
</fieldset>
