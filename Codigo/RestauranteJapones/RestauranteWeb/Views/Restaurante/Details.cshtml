    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Bairro)</dt><dd class="col-sm-10">@Model.Bairro</dd>
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Cidade)</dt><dd class="col-sm-10">@Model.Cidade</dd>
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Estado)</dt><dd class="col-sm-10">@Model.Estado</dd>
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Telefone1)</dt><dd class="col-sm-10">@Model.Telefone1</dd>
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Telefone2)</dt><dd class="col-sm-10">@Model.Telefone2</dd>
