@model RestauranteWeb.Models.RestauranteViewModel
@{
    ViewData["Title"] = "Detalhes do restaurante";
}
<h1>Detalhes do restaurante</h1>
<hr />
<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Nome)</dt><dd class="col-sm-9">@Model.Nome</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Cnpj)</dt><dd class="col-sm-9">@Model.Cnpj</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.NomeTipoRestaurante)</dt><dd class="col-sm-9">@Model.NomeTipoRestaurante</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Cep)</dt><dd class="col-sm-9">@Model.Cep</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Rua)</dt><dd class="col-sm-9">@Model.Rua</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Bairro)</dt><dd class="col-sm-9">@Model.Bairro</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Cidade)</dt><dd class="col-sm-9">@Model.Cidade</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Estado)</dt><dd class="col-sm-9">@Model.Estado</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Telefone1)</dt><dd class="col-sm-9">@Model.Telefone1</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Telefone2)</dt><dd class="col-sm-9">@Model.Telefone2</dd>
</dl>
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Voltar</a>
