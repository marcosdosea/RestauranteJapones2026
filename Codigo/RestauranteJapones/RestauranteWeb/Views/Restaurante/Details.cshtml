@model RestauranteWeb.Models.RestauranteViewModel
@{
    ViewData["Title"] = "Details";
}
<h1>Details</h1>
<hr />
<dl class="row">
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Nome)</dt><dd class="col-sm-10">@Model.Nome</dd>
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Cnpj)</dt><dd class="col-sm-10">@Model.Cnpj</dd>
