@model IEnumerable<RestauranteWeb.Models.FuncionarioViewModel>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nome)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Telefone1)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NomeRestaurante)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NomeTipoFuncionario)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Nome)
            </td>
            <td>
                @Html.DisplayFor(model => item.Cpf)
            </td>
            <td>
                @Html.DisplayFor(model => item.Cep)
            </td>
            <td>
                @Html.DisplayFor(model => item.Rua)
            </td>
            <td>
                @Html.DisplayFor(model => item.Bairro)
            </td>
            <td>
                @Html.DisplayFor(model => item.Cidade)
            </td>
            <td>
                @Html.DisplayFor(model => item.Estado)
            </td>
            <td>
                @Html.DisplayFor(model => item.Telefone1)
            </td>
            <td>
                @Html.DisplayFor(model => item.Telefone2)
            </td>
            <td>
                @Html.DisplayFor(model => item.NomeRestaurante)
            </td>
            <td>
                @Html.DisplayFor(model => item.NomeTipoFuncionario)
            </td>
            <td>
                @Html.DisplayFor(model => item.IdRestaurante)
            </td>
            <td>
                @Html.DisplayFor(model => item.IdTipoFuncionario)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
