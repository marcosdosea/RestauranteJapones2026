@model RestauranteWeb.Models.ItemCardapioViewModel
@{
    ViewData["Title"] = "Delete";
}
<h1>Delete</h1>
<h3>Are you sure you want to delete this?</h3>
<hr />
<section aria-labelledby="resumo-item-cardapio">
    <h2 id="resumo-item-cardapio" class="visually-hidden">Resumo do item do cardápio</h2>
    <dl class="row">
        <dt class="col-sm-2">Nome</dt><dd class="col-sm-10">@Model.Nome</dd>
        <dt class="col-sm-2">Grupo</dt><dd class="col-sm-10">@Model.NomeGrupoCardapio</dd>
        <dt class="col-sm-2">Restaurante</dt><dd class="col-sm-10">@Model.NomeRestaurante</dd>
    </dl>
</section>
<form asp-action="Delete">
    <p asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></p>
    <input type="hidden" asp-for="Id" />
    <input type="submit" value="Delete" class="btn btn-danger" /> |
    <a asp-action="Index">Back to List</a>
</form>
