@model RestauranteWeb.Models.ItemCardapioViewModel
@{
    ViewData["Title"] = "Details";
}
<h1>Details</h1>
<hr />
<dl class="row">
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Nome)</dt><dd class="col-sm-10">@Model.Nome</dd>
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Preco)</dt><dd class="col-sm-10">@Model.Preco?.ToString("N2")</dd>
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.NomeGrupoCardapio)</dt><dd class="col-sm-10">@Model.NomeGrupoCardapio</dd>
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.NomeRestaurante)</dt><dd class="col-sm-10">@Model.NomeRestaurante</dd>
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Detalhes)</dt><dd class="col-sm-10">@Model.Detalhes</dd>
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Ativo)</dt><dd class="col-sm-10">@Model.AtivoTexto</dd>
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Disponivel)</dt><dd class="col-sm-10">@Model.DisponivelTexto</dd>
</dl>
<a asp-action="Edit" asp-route-id="@Model.Id">Edit</a> |
<a asp-action="Index">Back to List</a>
